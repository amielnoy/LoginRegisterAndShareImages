<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TakeAPictureAndShowOnList.TakePictureActivity">

    <TextView
        android:id="@+id/textView_title"
        android:layout_width="88dp"
        android:layout_height="33dp"
        android:layout_marginBottom="48dp"
        android:text="Take a picture"
        app:layout_constraintBottom_toTopOf="@+id/take_picture_View"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.464"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/take_picture_View"
        android:layout_width="395dp"
        android:layout_height="514dp"
        android:foregroundGravity="center"
        android:onClick="imgClickHandler"
        app:layout_constraintBaseline_toBottomOf="@id/textView_title"
        app:layout_constraintEnd_toEndOf="@+id/textViewUseName"
        app:layout_constraintHorizontal_bias="0.522"
        app:layout_constraintStart_toStartOf="@+id/textViewUseName"
        app:srcCompat="@drawable/and_now_give_me_a_smile"
        tools:layout_editor_absoluteY="99dp"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <Button
        android:id="@+id/save_taken_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save the picture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewUseName"
        app:layout_constraintVertical_bias="0.959" />

    <TextView
        android:id="@+id/textViewUseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Click on the picture to TAKE A PHOTO"
        android:textStyle="bold"
        android:textColor="#0000FF"
        app:layout_constraintEnd_toEndOf="@+id/save_taken_image"
        app:layout_constraintStart_toStartOf="@+id/save_taken_image"
        app:layout_constraintTop_toBottomOf="@+id/take_picture_View" />


</androidx.constraintlayout.widget.ConstraintLayout>