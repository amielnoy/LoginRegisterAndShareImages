<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TakeAPictureAndShowOnList.TakePictureActivity">

    <ImageView
        android:id="@+id/take_picture_View"
        android:layout_width="395dp"
        android:layout_height="514dp"
        android:foregroundGravity="center"
        android:onClick="imgClickHandler"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/and_now_give_me_a_smile"
        tools:layout_editor_absoluteX="0dp"
        tools:srcCompat="@drawable/and_now_give_me_a_smile" />

    <TextView
        android:id="@+id/textViewUseName"
        android:layout_width="284dp"
        android:layout_height="41dp"
        android:layout_marginTop="28dp"
        android:text="Click picture to TAKE A PHOTO"
        android:textColor="#0000FF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/take_picture_View"
        app:layout_constraintHorizontal_bias="0.423"
        app:layout_constraintStart_toStartOf="@+id/take_picture_View"
        app:layout_constraintTop_toBottomOf="@+id/take_picture_View" />

    <Button
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:onClick="buttonSaveWithImageListener"
        android:text="ButtonSave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/textViewUseName"
        app:layout_constraintHorizontal_bias="0.518"
        app:layout_constraintStart_toStartOf="@+id/textViewUseName"
        app:layout_constraintTop_toTopOf="@+id/textViewUseName" />


</androidx.constraintlayout.widget.ConstraintLayout>