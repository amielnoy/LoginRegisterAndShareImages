<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_ground1"
    tools:context=".MainActivity.MainActivity">

    <TextView
        android:id="@+id/message_music"
        android:layout_width="270dp"
        android:layout_height="111dp"
        android:layout_marginTop="92dp"
        android:text="Click on Play Music if you want to listen to music while your taking photos"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="Play Music"
        android:background="@color/cardview_shadow_end_color"
        android:onClick="onStart"
        app:layout_constraintEnd_toEndOf="@+id/message_music"
        app:layout_constraintStart_toStartOf="@+id/message_music"
        app:layout_constraintTop_toBottomOf="@+id/message_music" />

    <Button
        android:id="@+id/button_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="148dp"
        android:background="@color/cardview_shadow_end_color"
        android:onClick="onStop"
        android:text="Stop music"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/button_play"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/button_play"
        app:layout_constraintTop_toBottomOf="@+id/button_play"
        app:layout_constraintVertical_bias="0.0" />


</androidx.constraintlayout.widget.ConstraintLayout>